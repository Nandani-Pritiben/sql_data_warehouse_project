GO

/*
Docstring: Bronze.erp_loc_a101
-------------------------------------------------------------------------------
Description: Maps geographical locations and country codes against specific Customer IDs.
Source File: erp_loc_a101.csv
*/
IF OBJECT_ID('Bronze.erp_loc_a101', 'U') IS NOT NULL
    DROP TABLE Bronze.erp_loc_a101;
GO

CREATE TABLE Bronze.erp_loc_a101 (
    CID   NVARCHAR(50),
    CNTRY NVARCHAR(50)
);
GO

/*
Docstring: Bronze.erp_px_cat_g1v2
-------------------------------------------------------------------------------
Description: Master reference table detailing standard category and sub-category groupings.
Source File: erp_px_cat_g1v2.csv
*/
IF OBJECT_ID('Bronze.erp_px_cat_g1v2', 'U') IS NOT NULL
    DROP TABLE Bronze.erp_px_cat_g1v2;
GO

CREATE TABLE Bronze.erp_px_cat_g1v2 (
    ID          NVARCHAR(50),
    CAT         NVARCHAR(50),
    SUBCAT      NVARCHAR(50),
    MAINTENANCE NVARCHAR(50)
);
GO
