/*
===============================================================================
DDL Script: Bronze Layer Tables Creation
===============================================================================
Description:
    This script initializes the schemas and baseline tables for the Bronze 
    (Staging) layer of the Data Warehouse. 
    It safely checks for existing tables, drops them if they exist, and 
    recreates them to ensure a clean slate before executing ETL processes.

Database Tier: Bronze / Staging Layer
Data Sources: 
    - CRM System (Customer, Product, Sales data)
    - ERP System (Customer profiles, Regional locations, Maintenance categories)
===============================================================================
*/

-- ============================================================================
-- Section 1: CRM Source Tables
-- ============================================================================

/*
Docstring: Bronze.crm_cust_info
-------------------------------------------------------------------------------
Description: Stores raw core customer attributes extracted directly from the CRM.
Source File: crm_cust_info.csv
Data Types: Keeps string metrics open using Unicode (NVARCHAR).
*/
IF OBJECT_ID('Bronze.crm_cust_info', 'U') IS NOT NULL
    DROP TABLE Bronze.crm_cust_info;
GO

CREATE TABLE Bronze.crm_cust_info (
    cst_id             INT,
    cst_key            NVARCHAR(50),
    cst_firstname      NVARCHAR(50),
    cst_lastname       NVARCHAR(50),
    cst_marital_status NVARCHAR(50),
    cst_gndr           NVARCHAR(50),
    cst_create_date    DATE
);
GO

/*
Docstring: Bronze.crm_prd_info
-------------------------------------------------------------------------------
Description: Contains raw master catalog records for products within the CRM.
Source File: crm_prd_info.csv
Data Types: Includes effective timestamp ranges for historical record tracing.
*/
IF OBJECT_ID('Bronze.crm_prd_info', 'U') IS NOT NULL
    DROP TABLE Bronze.crm_prd_info;
GO

CREATE TABLE Bronze.crm_prd_info (
    prd_id       INT,
    prd_key      NVARCHAR(50),
    prd_nm       NVARCHAR(50),
    prd_cost     INT,
    prd_line     NVARCHAR(50),
    prd_start_dt DATETIME,
    prd_end_dt   DATETIME
);
GO

/*
Docstring: Bronze.crm_sales_details
-------------------------------------------------------------------------------
Description: Captures granular transaction data for itemized customer sales orders.
Source File: crm_sales_details.csv
Data Types: Dates are stored temporarily as integers (yyyymmdd) based on the raw source structure.
*/
IF OBJECT_ID('Bronze.crm_sales_details', 'U') IS NOT NULL
    DROP TABLE Bronze.crm_sales_details;
GO

CREATE TABLE Bronze.crm_sales_details (
    sls_ord_num  NVARCHAR(50),
    sls_prd_key  NVARCHAR(50),
    sls_cust_id  INT,
    sls_order_dt INT,
    sls_ship_dt  INT,
    sls_due_dt   INT,
    sls_sales    INT,
    sls_quantity INT,
    sls_price    INT
);
GO


-- ============================================================================
-- Section 2: ERP Source Tables
-- ============================================================================

/*
Docstring: Bronze.erp_cust_az12
