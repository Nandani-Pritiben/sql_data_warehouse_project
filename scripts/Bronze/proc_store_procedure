 /*
===============================================================================
Stored Procedure: Bronze.load_data
===============================================================================
Description:
    This procedure manages the orchestration of data ingestion for the 
    Bronze (Staging) layer of the Data Warehouse. It truncates existing records
    and uses high-performance BULK INSERT commands to extract raw data 
    from flat CSV files (CRM and ERP sources) into local SQL Server tables.

Execution Details:
    - Implements structural runtime logging using execution timestamps.
    - Captures file-specific and total processing durations in seconds.
    - Includes robust TRY...CATCH blocks to handle runtime extraction failures.
===============================================================================
*/

CREATE OR ALTER PROCEDURE Bronze.load_data AS
BEGIN
    SET NOCOUNT ON; -- Prevents internal 'rows affected' messages from cluttering the output

    DECLARE @start_date DATETIME, @end_date DATETIME, @total_start_time DATETIME, @total_end_time DATETIME;
    
    BEGIN TRY
        PRINT '==================================================';
        PRINT 'STARTING BRONZE LAYER DATA LOAD';
        PRINT 'Start Time: ' + CONVERT(VARCHAR, GETDATE(), 120);
        SET @total_start_time = GETDATE();
        PRINT '==================================================';

        -- ====================================================================
        -- 1. LOAD: Bronze.crm_cust_info
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.crm_cust_info...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.crm_cust_info;
        BULK INSERT Bronze.crm_cust_info
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\cust_info.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.crm_cust_info loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.crm_cust_info;
        SELECT COUNT(*) FROM Bronze.crm_cust_info;

        -- ====================================================================
        -- 2. LOAD: Bronze.crm_prd_info
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.crm_prd_info...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.crm_prd_info;
        BULK INSERT Bronze.crm_prd_info
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\prd_info.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.crm_prd_info loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.crm_prd_info;
        SELECT COUNT(*) FROM Bronze.crm_prd_info;

        -- ====================================================================
        -- 3. LOAD: Bronze.crm_sales_details
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.crm_sales_details...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.crm_sales_details;
        BULK INSERT Bronze.crm_sales_details
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_crm\sales_details.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.crm_sales_details loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.crm_sales_details;
        SELECT COUNT(*) FROM Bronze.crm_sales_details;

        -- ====================================================================
        -- 4. LOAD: Bronze.erp_cust_az12
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.erp_cust_az12...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.erp_cust_az12;
        BULK INSERT Bronze.erp_cust_az12
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\cust_az12.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.erp_cust_az12 loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.erp_cust_az12;
        SELECT COUNT(*) FROM Bronze.erp_cust_az12;

        -- ====================================================================
        -- 5. LOAD: Bronze.erp_loc_a101
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.erp_loc_a101...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.erp_loc_a101;
        BULK INSERT Bronze.erp_loc_a101
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\loc_a101.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.erp_loc_a101 loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.erp_loc_a101;
        SELECT COUNT(*) FROM Bronze.erp_loc_a101;

        -- ====================================================================
        -- 6. LOAD: Bronze.erp_px_cat_g1v2
        -- ====================================================================
        PRINT '--------------------------------------------------';
        PRINT 'Loading Table: Bronze.erp_px_cat_g1v2...';
        SET @start_date = GETDATE();

        TRUNCATE TABLE Bronze.erp_px_cat_g1v2;
        BULK INSERT Bronze.erp_px_cat_g1v2
        FROM 'C:\sql-data-warehouse-project (1)\sql-data-warehouse-project\datasets\source_erp\px_cat_g1v2.csv'
        WITH(
             FIRSTROW = 2,
             FIELDTERMINATOR = ',',
             TABLOCK
        );
        
        SET @end_date = GETDATE();
        PRINT '>> Success: Bronze.erp_px_cat_g1v2 loaded successfully.';
        PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_date, @end_date) AS NVARCHAR) + ' seconds';
        
        SELECT * FROM Bronze.erp_px_cat_g1v2;
        SELECT COUNT(*) FROM Bronze.erp_px_cat_g1v2;

        -- ====================================================================
        -- FINAL TRACKING SUMMARY
        -- ====================================================================
        SET @total_end_time = GETDATE();
        PRINT '==================================================';
        PRINT 'BRONZE LAYER DATA LOAD COMPLETE';
        PRINT 'End Time: ' + CONVERT(VARCHAR, GETDATE(), 120);
        PRINT '>> Total Bronze Layer Loading Duration: ' + CAST(DATEDIFF(second, @total_start_time, @total_end_time) AS NVARCHAR) + ' seconds';
        PRINT '==================================================';

    END TRY
    BEGIN CATCH
        PRINT '==================================================';
        PRINT 'ERROR OCCURRED DURING BRONZE LAYER LOAD';
        PRINT 'ERROR MESSAGE : ' + ERROR_MESSAGE();
        PRINT 'ERROR NUMBER  : ' + CAST(ERROR_NUMBER() AS NVARCHAR);
        PRINT 'ERROR STATE   : ' + CAST(ERROR_STATE() AS NVARCHAR);
        PRINT '==================================================';
    END CATCH;
END;
GO
